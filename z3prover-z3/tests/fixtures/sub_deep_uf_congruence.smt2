; Deep-dive: uninterpreted functions with congruence closure chain
(set-logic QF_UF)
(set-option :produce-models true)
(declare-sort U 0)
(declare-fun f (U) U)
(declare-fun g (U U) U)
(declare-const a U)
(declare-const b U)
(declare-const c U)
; a = b, so f(a) = f(b), and g(a,f(a)) = g(b,f(b))
(assert (= a b))
(assert (= (g a (f a)) c))
(check-sat)
(get-value ((f a) (f b) (g b (f b)) c))
