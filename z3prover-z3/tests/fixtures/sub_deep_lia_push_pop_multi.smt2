; Deep-dive: push/pop with incremental solving (multiple scopes)
(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (> x 0))
(push 1)
  (assert (= x 5))
  (push 1)
    (assert (= y 10))
    (check-sat)
    (get-value (x y))
  (pop 1)
  ; y is no longer constrained to 10
  (assert (= y 20))
  (check-sat)
  (get-value (x y))
(pop 1)
; x is no longer constrained to 5
(assert (= x 99))
(check-sat)
(get-value (x y))
