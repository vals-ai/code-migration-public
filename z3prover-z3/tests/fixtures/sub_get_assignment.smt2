; Model gen: get-assignment on named Boolean formulas (define-fun style)
(set-logic QF_LIA)
(set-option :produce-assignments true)
(set-option :produce-models true)
(declare-const x Int)
(define-fun p () Bool (> x 0))
(define-fun q () Bool (< x 10))
(assert p)
(assert q)
(assert (= x 5))
(check-sat)
(get-assignment)
