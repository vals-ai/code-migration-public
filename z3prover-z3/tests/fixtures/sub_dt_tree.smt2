; Datatype: binary tree with sat instance (node has non-leaf children)
(set-logic ALL)
(set-option :produce-models true)
(declare-datatypes ((Tree 0)) (((leaf (val Int)) (node (left Tree) (right Tree)))))
(declare-const t Tree)
(assert (is-node t))
(assert (is-leaf (left t)))
(assert (is-leaf (right t)))
(assert (= (val (left t)) 3))
(assert (= (val (right t)) 7))
(check-sat)
(get-model)
