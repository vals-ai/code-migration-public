; Deep-dive: SMT-LIB2 integer division semantics for negative numbers
; In SMT-LIB2, div rounds toward negative infinity (Euclidean-like)
; div(-7, 2) = -4 (not -3), mod(-7, 2) = 1 (not -1)
(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const d1 Int)
(declare-const m1 Int)
(declare-const d2 Int)
(declare-const m2 Int)
(assert (= d1 (div (- 7) 2)))
(assert (= m1 (mod (- 7) 2)))
(assert (= d2 (div 7 (- 2))))
(assert (= m2 (mod 7 (- 2))))
(check-sat)
(get-value (d1 m1 d2 m2))
