; Optimization: assert-soft with :id grouping (partitioned objectives)
(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (>= x 0))
(assert (>= y 0))
(assert-soft (= x 0) :weight 5 :id group1)
(assert-soft (= x 1) :weight 3 :id group1)
(assert-soft (= y 0) :weight 4 :id group2)
(assert-soft (= y 1) :weight 6 :id group2)
(check-sat)
(get-objectives)
