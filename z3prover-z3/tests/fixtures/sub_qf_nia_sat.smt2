; QF_NIA: nonlinear integer arithmetic - Pythagorean triple check (sat)
(set-logic QF_NIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (> x 0))
(assert (> y 0))
(assert (> z 0))
(assert (= (+ (* x x) (* y y)) (* z z)))
(assert (= x 3))
(assert (= y 4))
(check-sat)
(get-model)
