; Datatype: mutually recursive datatypes (Even/Odd number trees)
(set-logic ALL)
(set-option :produce-models true)
(declare-datatypes ((EvenList 0) (OddList 0))
  (((enil) (econs (ehead Int) (etail OddList)))
   ((ocons (ohead Int) (otail EvenList)))))
(declare-const el EvenList)
(declare-const ol OddList)
(assert (= el (econs 2 (ocons 1 enil))))
(assert (= ol (ocons 3 enil)))
(check-sat)
(get-value (el ol (ehead el) (ohead (etail el))))
